{
  "manifest_version": 3,
  "name": "PhishGuard • Real-Time Web & URL Shield",
  "version": "2.4.0",
  "description": "Real-time AI-powered phishing and malicious link detection extension.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "PhishGuard Protection"
  }
}
